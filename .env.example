# Copiez ce fichier en `.env` et remplissez les valeurs. Ne publiez jamais le fichier .env.

# Connexion MySQL : mysql://UTILISATEUR:MOT_DE_PASSE@HOTE:PORT/BASE
# (caractères spéciaux du mot de passe à encoder : @ → %40, # → %23, / → %2F…)
DATABASE_URL="mysql://fibetech:motdepasse@localhost:3306/fibetech"

# Clé secrète qui signe les sessions de l'admin (au moins 32 caractères aléatoires).
# Pour en générer une : node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET="remplacez-moi-par-une-longue-cle-aleatoire"

# Premier compte administrateur, créé par `npm run db:seed` s'il n'existe aucun compte.
# Retirez ADMIN_PASSWORD de ce fichier une fois connecté.
ADMIN_EMAIL="admin@fibetech.cd"
ADMIN_PASSWORD="choisissez-un-mot-de-passe-solide"
ADMIN_NAME="Administrateur"

# Envoi des alertes d’inscription à la lettre d’information (Resend).
# Utilisez une adresse d’expéditeur appartenant à un domaine vérifié dans Resend.
RESEND_API_KEY="re_votre_cle_api"
RESEND_FROM_EMAIL="Fibetech <contact@votre-domaine.cd>"

# Adresse publique du site (balises de partage sur les réseaux sociaux). Facultatif.
# SITE_URL="https://www.fibetech.cd"

# Dossier où sont enregistrées les images envoyées depuis l'admin (facultatif, ./uploads par défaut).
# Il doit être conservé entre deux déploiements.
# UPLOAD_DIR="./uploads"

# Uniquement si le site est servi sans HTTPS en production (déconseillé).
# COOKIE_SECURE="false"
