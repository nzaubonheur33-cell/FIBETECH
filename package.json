{
  "name": "fibetech-site",
  "private": true,
  "version": "2.0.0",
  "description": "Site de Fibetech, startup informatique à Lubumbashi, avec son espace d'administration (Next.js + MySQL).",
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "build:static": "node scripts/build-static.mjs",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "db:deploy": "prisma migrate deploy",
    "db:migrate": "prisma migrate dev",
    "db:seed": "tsx prisma/seed.ts",
    "db:studio": "prisma studio",
    "admin:create": "tsx scripts/create-admin.ts",
    "postinstall": "prisma generate"
  },
  "engines": {
    "node": ">=20.12"
  },
  "dependencies": {
    "@fontsource-variable/bricolage-grotesque": "5.1.0",
    "@fontsource-variable/figtree": "5.1.0",
    "@fontsource/jetbrains-mono": "5.1.0",
    "@prisma/client": "6.19.3",
    "bcryptjs": "3.0.3",
    "clsx": "2.1.1",
    "gsap": "3.12.5",
    "jose": "6.2.15",
    "next": "15.5.29",
    "react": "19.2.9",
    "react-dom": "19.2.9",
    "tailwind-merge": "2.5.5"
  },
  "devDependencies": {
    "@types/node": "22.10.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "autoprefixer": "10.4.20",
    "postcss": "8.5.31",
    "prisma": "6.19.3",
    "tailwindcss": "3.4.17",
    "tsx": "4.23.15",
    "typescript": "5.6.3"
  }
}
